{
  "opencollection": "1.0.0",
  "info": {
    "name": "CloudRF 3D Template API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "key",
      "value": "{{key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Template",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List templates",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.cloudrf.com/template"
          },
          "docs": "List custom user templates."
        },
        {
          "info": {
            "name": "Create template",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.cloudrf.com/template"
          },
          "docs": "Store a new custom template."
        }
      ]
    }
  ],
  "bundled": true
}